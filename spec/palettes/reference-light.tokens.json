{
  "palette": {
    "$type": "color",
    "neutral025": { "$value": { "colorSpace": "srgb", "components": [0.9843, 0.9882, 0.9922], "hex": "#FBFCFD" } },
    "neutral050": { "$value": { "colorSpace": "srgb", "components": [0.9569, 0.9686, 0.9843], "hex": "#F4F7FB" } },
    "neutral100": { "$value": { "colorSpace": "srgb", "components": [0.9176, 0.9333, 0.9569], "hex": "#EAEFF4" } },
    "neutral300": { "$value": { "colorSpace": "srgb", "components": [0.7216, 0.7569, 0.8078], "hex": "#B8C1CE" } },
    "neutral500": { "$value": { "colorSpace": "srgb", "components": [0.4314, 0.4706, 0.5333], "hex": "#6E7888" } },
    "neutral700": { "$value": { "colorSpace": "srgb", "components": [0.2549, 0.2863, 0.3412], "hex": "#414957" } },
    "neutral900": { "$value": { "colorSpace": "srgb", "components": [0.102, 0.1216, 0.1569], "hex": "#1A1F28" } },
    "white": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#FFFFFF" } },
    "accent500": { "$value": { "colorSpace": "srgb", "components": [0.4078, 0.302, 0.8863], "hex": "#684DE2" } },
    "accent400": { "$value": { "colorSpace": "srgb", "components": [0.4549, 0.3412, 0.9098], "hex": "#7457E8" } },
    "accent600": { "$value": { "colorSpace": "srgb", "components": [0.3255, 0.2235, 0.7569], "hex": "#5339C1" } },
    "success500": { "$value": { "colorSpace": "srgb", "components": [0.1176, 0.6196, 0.3961], "hex": "#1E9E65" } },
    "warning500": { "$value": { "colorSpace": "srgb", "components": [0.7608, 0.4941, 0.0941], "hex": "#C27E18" } },
    "danger400": { "$value": { "colorSpace": "srgb", "components": [0.8039, 0.251, 0.3216], "hex": "#CD4052" } },
    "danger500": { "$value": { "colorSpace": "srgb", "components": [0.7725, 0.2078, 0.2863], "hex": "#C53549" } },
    "danger600": { "$value": { "colorSpace": "srgb", "components": [0.6824, 0.149, 0.2314], "hex": "#AE263B" } }
  },
  "semantic": {
    "color": {
      "$type": "color",
      "background": { "$value": "{palette.neutral025}" },
      "surface": { "$value": "{palette.white}" },
      "surfaceElevated": { "$value": "{palette.neutral050}" },
      "surfaceTranslucent": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 0.72, "hex": "#FFFFFF" } },
      "surfaceElevatedTranslucent": { "$value": { "colorSpace": "srgb", "components": [0.9569, 0.9686, 0.9843], "alpha": 0.82, "hex": "#F4F7FB" } },
      "textPrimary": { "$value": "{palette.neutral900}" },
      "textSecondary": { "$value": "{palette.neutral700}" },
      "textDisabled": { "$value": "{palette.neutral500}" },
      "accent": { "$value": "{palette.accent500}" },
      "accentHover": { "$value": "{palette.accent400}" },
      "accentPressed": { "$value": "{palette.accent600}" },
      "onAccent": { "$value": "{palette.white}" },
      "border": { "$value": "{palette.neutral500}" },
      "borderStrong": { "$value": "{palette.neutral700}" },
      "focus": { "$value": "{palette.accent400}" },
      "success": { "$value": "{palette.success500}" },
      "warning": { "$value": "{palette.warning500}" },
      "danger": { "$value": "{palette.danger500}" },
      "dangerHover": { "$value": "{palette.danger400}" },
      "dangerPressed": { "$value": "{palette.danger600}" }
    }
  }
}
