{
  "specVersion": "0.1.0",
  "theme": "spacey",
  "extends": "basic",
  "components": {
    "button": {
      "base": {
        "root": {
          "radius": "{radius.pill}"
        }
      }
    },
    "checkbox": {
      "base": {
        "root": {
          "fill": "{semantic.color.surface}",
          "border": {
            "color": "{semantic.color.borderStrong}",
            "width": "{border.width.standard}"
          }
        }
      }
    },
    "data-grid": {
      "base": {
        "root": {
          "radius": "{radius.sm}",
          "border": {
            "color": "{semantic.color.borderStrong}",
            "width": "{border.width.standard}"
          }
        }
      }
    },
    "dialog": {
      "base": {
        "root": {
          "radius": "{radius.sm}",
          "border": {
            "color": "{semantic.color.borderStrong}",
            "width": "{border.width.standard}"
          }
        }
      }
    },
    "input": {
      "base": {
        "root": {
          "fill": "{semantic.color.surface}",
          "radius": "{radius.pill}",
          "border": {
            "color": "{semantic.color.borderStrong}",
            "width": "{border.width.standard}"
          }
        }
      }
    },
    "menu": {
      "base": {
        "popup": {
          "border": {
            "color": "{semantic.color.borderStrong}",
            "width": "{border.width.standard}"
          }
        },
        "separator": {
          "fill": "{semantic.color.borderStrong}"
        }
      }
    },
    "navigation": {
      "base": {
        "list": {
          "radius": "{radius.sm}",
          "border": {
            "color": "{semantic.color.borderStrong}",
            "width": "{border.width.standard}"
          }
        },
        "item": {
          "radius": "{radius.sm}"
        }
      }
    },
    "panel": {
      "base": {
        "root": {
          "fill": "{semantic.color.surface}",
          "radius": "{radius.sm}",
          "border": {
            "color": "{semantic.color.borderStrong}",
            "width": "{border.width.standard}"
          }
        }
      }
    },
    "progress": {
      "variants": {
        "circular": {
          "base": {
            "track": {
              "border": {
                "color": "{semantic.color.borderStrong}",
                "width": "{component.progress.circular.stroke.medium}"
              }
            }
          }
        }
      }
    },
    "radio": {
      "base": {
        "root": {
          "fill": "{semantic.color.surface}",
          "border": {
            "color": "{semantic.color.borderStrong}",
            "width": "{border.width.standard}"
          }
        }
      }
    },
    "select": {
      "base": {
        "root": {
          "fill": "{semantic.color.surface}",
          "radius": "{radius.pill}",
          "border": {
            "color": "{semantic.color.borderStrong}",
            "width": "{border.width.standard}"
          }
        }
      }
    },
    "slider": {
      "base": {
        "track": {
          "fill": "{semantic.color.surface}",
          "border": {
            "color": "{semantic.color.borderStrong}",
            "width": "{border.width.standard}"
          }
        },
        "thumb": {
          "fill": "{semantic.color.surface}",
          "border": {
            "color": "{semantic.color.borderStrong}",
            "width": "{border.width.standard}"
          }
        }
      }
    },
    "switch": {
      "base": {
        "root": {
          "radius": "{radius.pill}",
          "border": {
            "color": "{semantic.color.borderStrong}",
            "width": "{border.width.standard}"
          }
        },
        "thumb": {
          "radius": "{radius.pill}"
        }
      },
      "states": {
        "checked": {
          "root": {
            "border": {
              "color": "{semantic.color.borderStrong}",
              "width": "{border.width.standard}"
            }
          }
        }
      }
    },
    "table": {
      "base": {
        "root": {
          "fill": "{semantic.color.surface}",
          "radius": "{radius.sm}",
          "border": {
            "color": "{semantic.color.borderStrong}",
            "width": "{border.width.standard}"
          }
        },
        "header": {
          "fill": "{semantic.color.surfaceElevated}"
        }
      }
    },
    "tabs": {
      "base": {
        "tabList": {
          "border": {
            "color": "{semantic.color.borderStrong}",
            "width": "{border.width.standard}"
          }
        }
      }
    },
    "toast": {
      "base": {
        "root": {
          "fill": "{semantic.color.background}"
        }
      }
    },
    "tooltip": {
      "base": {
        "popup": {
          "fill": "{semantic.color.background}",
          "border": {
            "color": "{semantic.color.borderStrong}",
            "width": "{border.width.standard}"
          }
        }
      }
    },
    "tree": {
      "base": {
        "root": {
          "radius": "{radius.sm}",
          "border": {
            "color": "{semantic.color.borderStrong}",
            "width": "{border.width.standard}"
          }
        },
        "item": {
          "radius": "{radius.sm}"
        }
      }
    }
  }
}
