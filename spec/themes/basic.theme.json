        "large": {
          "root": {
            "minWidth": "{component.radio.control.size.large}",
            "minHeight": "{component.radio.control.size.large}"
          },
          "indicator": {
            "minWidth": "{component.radio.indicator.size.large}",
            "minHeight": "{component.radio.indicator.size.large}"
          }
        }
      },
      "states": {
        "hover": {
          "root": {
            "fill": "{semantic.color.surfaceHover}"
          }
        },
        "focus": {
          "root": {
            "outline": {
              "color": "{semantic.color.focus}",
              "width": "{focus.ring.width}",
              "offset": "{focus.ring.offset}"
            }
          }
        },
        "pressed": {
          "root": {
            "fill": "{semantic.color.surfacePressed}"
          }
        },
        "selected": {
          "root": {
            "fill": "{semantic.color.accent}",
            "border": {
              "color": "{semantic.color.accent}",
