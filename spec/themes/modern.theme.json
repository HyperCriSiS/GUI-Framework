{
  "specVersion": "0.1.0",
  "theme": "modern",
  "extends": "basic",
  "components": {
    "button": {
      "base": {
        "root": {
          "radius": "{radius.lg}"
        }
      }
    },
    "checkbox": {
      "base": {
        "root": {
          "radius": "{radius.md}"
        }
      }
    },
    "data-grid": {
      "base": {
        "root": {
          "radius": "{radius.xl}"
        }
      }
    },
    "dialog": {
      "base": {
        "root": {
          "radius": "{radius.xl}",
          "shadow": "{elevation.shadow.medium}"
        }
      }
    },
    "input": {
      "base": {
        "root": {
          "radius": "{radius.lg}"
        }
      }
    },
    "menu": {
      "base": {
        "popup": {
          "radius": "{radius.xl}"
        },
        "item": {
          "radius": "{radius.lg}"
        }
      }
    },
    "navigation": {
      "base": {
        "list": {
          "radius": "{radius.xl}"
        },
        "item": {
          "radius": "{radius.lg}"
        },
        "indicator": {
          "radius": "{radius.pill}"
        }
      }
    },
    "panel": {
      "base": {
        "root": {
          "radius": "{radius.xl}",
          "shadow": "{elevation.shadow.low}"
        }
      }
    },
    "select": {
      "base": {
        "root": {
          "radius": "{radius.lg}"
        }
      }
    },
    "switch": {
      "base": {
        "root": {
          "radius": "{radius.pill}"
        },
        "thumb": {
          "radius": "{radius.pill}"
        }
      }
    },
    "table": {
      "base": {
        "root": {
          "radius": "{radius.xl}"
        }
      }
    },
    "tabs": {
      "base": {
        "tabList": {
          "radius": "{radius.xl}"
        },
        "tab": {
          "radius": "{radius.lg}"
        },
        "indicator": {
          "radius": "{radius.pill}"
        }
      }
    },
    "toast": {
      "base": {
        "root": {
          "radius": "{radius.xl}"
        }
      }
    },
    "tooltip": {
      "base": {
        "popup": {
          "radius": "{radius.lg}"
        }
      }
    },
    "tree": {
      "base": {
        "root": {
          "radius": "{radius.xl}"
        },
        "item": {
          "radius": "{radius.lg}"
        }
      }
    }
  }
}
