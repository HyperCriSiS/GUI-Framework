    {
      "id": "value",
      "type": "string",
      "required": true
    },
    {
      "id": "placeholder",
      "type": "string",
      "required": false,
      "default": ""
    },
    {
      "id": "disabled",
      "type": "boolean",
      "required": false,
      "default": false,
      "state": "disabled"
    },
    {
      "id": "readOnly",
      "type": "boolean",
      "required": false,
      "default": false
    },
    {
      "id": "error",
      "type": "boolean",
      "required": false,
      "default": false,
      "state": "error"
    }
  ],
  "events": [
