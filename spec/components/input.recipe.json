      "id": "valueChange",
      "payload": "string"
    }
  ],
  "variants": [
    "standard"
  ],
  "sizes": [
    "small",
    "medium",
    "large"
  ],
  "states": [
    "default",
    "hover",
    "focus",
    "disabled",
    "error"
  ],
