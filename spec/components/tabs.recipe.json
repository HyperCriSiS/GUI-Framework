{
  "specVersion": "0.1.0",
  "component": "tabs",
  "anatomy": [
    {"id":"root","required":true},
    {"id":"tabList","required":true},
    {"id":"tab","required":true},
    {"id":"indicator","required":true},
    {"id":"panel","required":true}
  ],
  "content": [
    {"id":"tab","kind":"children","required":true},
    {"id":"panel","kind":"children","required":true}
  ],
  "properties": [
    {"id":"value","type":"string","required":true},
    {"id":"accessibilityLabel","type":"string","required":false,"default":""},
    {"id":"disabled","type":"boolean","required":false,"default":false,"state":"disabled"}
  ],
  "events": [{"id":"valueChange","payload":"string"}],
  "variants": ["standard"],
  "sizes": ["small","medium","large"],
  "states": ["default","hover","focus","pressed","selected","disabled"],
  "semantics": {"role":"tablist","preferNativePrimitive":true},
  "tokenBindings": {
    "surface":"{semantic.color.surfaceElevated}",
    "text":"{semantic.color.textPrimary}",
    "textMuted":"{semantic.color.textSecondary}",
    "selected":"{semantic.color.accent}",
    "border":"{semantic.color.border}",
    "focus":"{semantic.color.focus}",
    "disabledOpacity":"{opacity.disabled}"
  },
  "capabilities": {
    "required":[],
    "optional":["advancedBlendModes","shaderEffects"],
    "fallbackOrder":["standard","minimal"]
  }
}
