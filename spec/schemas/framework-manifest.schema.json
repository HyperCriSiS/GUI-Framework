{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GUI Framework specification manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specVersion",
    "tokenSources",
    "palettes",
    "themes",
    "components"
  ],
  "properties": {
    "specVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "tokenSources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceEntry"
      }
    },
    "palettes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/sourceEntry"
          },
          {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "developmentReference": {
                "type": "boolean"
              }
            },
            "required": [
              "name"
            ]
          }
        ]
      }
    },
    "themes": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "source"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceEntry"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "sourceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "developmentReference": {
          "type": "boolean"
        }
      }
    }
  }
}
