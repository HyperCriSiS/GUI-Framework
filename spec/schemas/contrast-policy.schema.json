{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GUI Framework semantic contrast policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["policyVersion", "checks"],
  "properties": {
    "policyVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "foreground", "background", "minimum"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "category": { "enum": ["text", "non-text"] },
          "foreground": { "$ref": "#/$defs/tokenPath" },
          "background": { "$ref": "#/$defs/tokenPath" },
          "minimum": { "type": "number", "minimum": 1, "maximum": 21 }
        }
      }
    }
  },
  "$defs": {
    "tokenPath": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9-]*(?:\\.[A-Za-z][A-Za-z0-9-]*)+$"
    }
  }
}
