{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GUI Framework component recipe",
  "type": "object",
  "additionalProperties": false,
  "required": ["specVersion", "component", "anatomy", "variants", "sizes", "states", "semantics", "tokenBindings", "capabilities"],
  "properties": {
    "specVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "component": { "$ref": "#/$defs/id" },
    "anatomy": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "required"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "required": { "type": "boolean" }
        }
      }
    },
    "variants": { "$ref": "#/$defs/idArray" },
    "sizes": { "$ref": "#/$defs/idArray" },
    "states": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["default", "hover", "focus", "pressed", "selected", "checked", "disabled", "loading", "error", "success", "expanded"]
      },
      "contains": { "const": "default" }
    },
    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "preferNativePrimitive"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "preferNativePrimitive": { "type": "boolean" }
      }
    },
    "tokenBindings": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/tokenReference" }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "optional", "fallbackOrder"],
      "properties": {
        "required": { "$ref": "#/$defs/idArray" },
        "optional": { "$ref": "#/$defs/idArray" },
        "fallbackOrder": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["ultra", "high", "standard", "minimal"] }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9-]*$"
    },
    "idArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "tokenReference": {
      "type": "string",
      "pattern": "^\\{[^{}.]+(?:\\.[^{}.]+)*\\}$"
    }
  }
}
