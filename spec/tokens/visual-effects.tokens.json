{
  "effect": {
    "blur": {
      "$type": "dimension",
      "none": { "$value": { "value": 0, "unit": "px" } },
      "subtle": { "$value": { "value": 4, "unit": "px" } },
      "medium": { "$value": { "value": 8, "unit": "px" } },
      "strong": { "$value": { "value": 16, "unit": "px" } },
      "frosted": { "$value": { "value": 24, "unit": "px" } }
    },
    "glow": {
      "$type": "dimension",
      "none": { "$value": { "value": 0, "unit": "px" } },
      "subtle": { "$value": { "value": 4, "unit": "px" } },
      "medium": { "$value": { "value": 8, "unit": "px" } },
      "strong": { "$value": { "value": 16, "unit": "px" } }
    },
    "noise": {
      "$type": "number",
      "none": { "$value": 0 },
      "subtle": { "$value": 0.015 },
      "medium": { "$value": 0.03 },
      "strong": { "$value": 0.05 }
    }
  },
  "elevation": {
    "color": {
      "$type": "color",
      "$value": { "colorSpace": "srgb", "components": [0, 0, 0] }
    },
    "shadowColor": {
      "$type": "color",
      "low": { "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.14 } },
      "medium": { "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.18 } }
    },
    "none": {
      "offsetX": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
      "offsetY": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
      "blur": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
      "spread": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
      "opacity": { "$type": "number", "$value": 0 }
    },
    "low": {
      "offsetX": { "$type": "dimension", "$value": "{elevation.none.offsetX}" },
      "offsetY": { "$type": "dimension", "$value": { "value": 2, "unit": "px" } },
      "blur": { "$type": "dimension", "$value": { "value": 6, "unit": "px" } },
      "spread": { "$type": "dimension", "$value": "{elevation.none.spread}" },
      "opacity": { "$type": "number", "$value": 0.14 }
    },
    "medium": {
      "offsetX": { "$type": "dimension", "$value": "{elevation.none.offsetX}" },
      "offsetY": { "$type": "dimension", "$value": { "value": 6, "unit": "px" } },
      "blur": { "$type": "dimension", "$value": { "value": 18, "unit": "px" } },
      "spread": { "$type": "dimension", "$value": { "value": -2, "unit": "px" } },
      "opacity": { "$type": "number", "$value": 0.18 }
    },
    "high": {
      "offsetX": { "$type": "dimension", "$value": "{elevation.none.offsetX}" },
      "offsetY": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
      "blur": { "$type": "dimension", "$value": { "value": 32, "unit": "px" } },
      "spread": { "$type": "dimension", "$value": { "value": -4, "unit": "px" } },
      "opacity": { "$type": "number", "$value": 0.24 }
    },
    "shadow": {
      "$type": "shadow",
      "low": {
        "$value": {
          "color": "{elevation.shadowColor.low}",
          "offsetX": "{elevation.low.offsetX}",
          "offsetY": "{elevation.low.offsetY}",
          "blur": "{elevation.low.blur}",
          "spread": "{elevation.low.spread}"
        }
      },
      "medium": {
        "$value": {
          "color": "{elevation.shadowColor.medium}",
          "offsetX": "{elevation.medium.offsetX}",
          "offsetY": "{elevation.medium.offsetY}",
          "blur": "{elevation.medium.blur}",
          "spread": "{elevation.medium.spread}"
        }
      }
    }
  }
}
