{
  "spacing": {
    "$type": "dimension",
    "xs": { "$value": { "value": 4, "unit": "px" } },
    "sm": { "$value": { "value": 8, "unit": "px" } },
    "md": { "$value": { "value": 12, "unit": "px" } },
    "lg": { "$value": { "value": 16, "unit": "px" } },
    "xl": { "$value": { "value": 24, "unit": "px" } }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": { "value": 6, "unit": "px" } },
    "md": { "$value": { "value": 10, "unit": "px" } },
    "lg": { "$value": { "value": 14, "unit": "px" } },
    "control": { "$value": "{radius.md}" }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "instant": { "$value": { "value": 0, "unit": "ms" } },
      "fast": { "$value": { "value": 120, "unit": "ms" } },
      "normal": { "$value": { "value": 180, "unit": "ms" } }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0, 0, 1] },
      "enter": { "$value": [0, 0, 0, 1] },
      "exit": { "$value": [0.4, 0, 1, 1] }
    },
    "interaction": {
      "fast": {
        "$type": "transition",
        "$value": {
          "duration": "{motion.duration.fast}",
          "delay": "{motion.duration.instant}",
          "timingFunction": "{motion.easing.standard}"
        }
      }
    }
  },
  "opacity": {
    "$type": "number",
    "disabled": { "$value": 0.5 },
    "subtle": { "$value": 0.72 },
    "hover": { "$value": 0.92 },
    "pressed": { "$value": 0.82 }
  },
  "sizing": {
    "$type": "dimension",
    "control": {
      "small": { "$value": { "value": 30, "unit": "px" } },
      "medium": { "$value": { "value": 36, "unit": "px" } },
      "large": { "$value": { "value": 44, "unit": "px" } }
    }
  },
  "border": {
    "width": {
      "$type": "dimension",
      "standard": { "$value": { "value": 1, "unit": "px" } }
    }
  },
  "focus": {
    "ring": {
      "$type": "dimension",
      "width": { "$value": { "value": 2, "unit": "px" } },
      "offset": { "$value": { "value": 2, "unit": "px" } }
    }
  },
  "typography": {
    "size": {
      "$type": "dimension",
      "small": { "$value": { "value": 13, "unit": "px" } },
      "medium": { "$value": { "value": 14, "unit": "px" } },
      "large": { "$value": { "value": 15, "unit": "px" } }
    },
    "weight": {
      "$type": "number",
      "medium": { "$value": 500 }
    },
    "lineHeight": {
      "$type": "number",
      "control": { "$value": 1.2 }
    }
  }
}
