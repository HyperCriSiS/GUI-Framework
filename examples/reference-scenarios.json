{
  "version": 1,
  "id": "initial-reference-core",
  "theme": "basic",
  "palette": "reference-dark",
  "components": [
    "button",
    "input",
    "switch",
    "panel",
    "dialog"
  ],
  "flows": [
    {
      "id": "edit-primary-input",
      "component": "input",
      "event": "value-change"
    },
    {
      "id": "toggle-switch",
      "component": "switch",
      "event": "checked-change"
    },
    {
      "id": "open-dialog",
      "component": "button",
      "event": "activate"
    },
    {
      "id": "dismiss-dialog",
      "component": "dialog",
      "event": "dismiss-request"
    },
    {
      "id": "close-dialog-action",
      "component": "button",
      "event": "activate"
    }
  ],
  "platformExtensions": {
    "web": [
      "palette-toggle",
      "extension-host-contexts"
    ],
    "composeDesktop": [
      "native-window"
    ],
    "composeAndroid": [
      "activity-host"
    ]
  },
  "densityProfiles": {
    "standard": {
      "usesComponentDefaults": true
    },
    "compact": {
      "componentSize": "small",
      "minimumViewportWidth": 320
    }
  },
  "phase6StructuredData": {
    "columns": [
      "Project",
      "Owner",
      "Status"
    ],
    "rows": [
      {
        "value": "atlas",
        "cells": [
          "Atlas",
          "Mira",
          "Ready"
        ],
        "disabled": false
      },
      {
        "value": "nova",
        "cells": [
          "Nova",
          "Kai",
          "Review"
        ],
        "disabled": false
      },
      {
        "value": "archive",
        "cells": [
          "Archive",
          "System",
          "Locked"
        ],
        "disabled": true
      }
    ],
    "initialValue": "atlas",
    "disabledValue": "archive"
  },
  "phase6Hierarchy": {
    "initialValue": "workspace",
    "nodes": [
      {
        "value": "workspace",
        "label": "Workspace",
        "expanded": true,
        "children": [
          {
            "value": "atlas",
            "label": "Atlas",
            "disabled": false
          },
          {
            "value": "archive",
            "label": "Archive",
            "disabled": true
          }
        ]
      },
      {
        "value": "settings",
        "label": "Settings",
        "disabled": false
      }
    ],
    "disabledValue": "archive"
  },
  "phase6FormLayout": {
    "columns": 2,
    "initialVariant": "inline",
    "compactColumns": 1,
    "fields": [
      {
        "id": "email",
        "label": "Email",
        "initialValue": "jan@example.com",
        "disabled": false,
        "error": false
      },
      {
        "id": "recovery",
        "label": "Recovery code",
        "initialValue": "12",
        "disabled": false,
        "error": true
      },
      {
        "id": "token",
        "label": "API token",
        "initialValue": "sk-local-reference",
        "disabled": true,
        "error": false
      }
    ],
    "validRecoveryValue": "ABC123"
  },
  "phase6ScrollContainer": {
    "variant": "vertical",
    "accessibilityLabel": "Activity log viewport",
    "keyboardFocusable": true,
    "items": [
      "Activity event 01",
      "Activity event 02",
      "Activity event 03",
      "Activity event 04",
      "Activity event 05",
      "Activity event 06",
      "Activity event 07",
      "Activity event 08",
      "Activity event 09",
      "Activity event 10",
      "Activity event 11",
      "Activity event 12"
    ],
    "targetItem": "Activity event 12",
    "hostOwnsOffset": true
  }
}
