{
  "name": "gui-framework-workspace",
  "private": true,
  "version": "0.0.0-development",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "npx --yes --package typescript@7.0.2 tsc -p packages/core/tsconfig.json --noEmit",
    "validate:dtcg": "node scripts/validate-dtcg.mjs",
    "validate:manifest": "npx --yes ajv-cli@5.0.0 validate --spec=draft2020 --strict=false -s spec/schemas/framework-manifest.schema.json -d spec/manifest.json",
    "validate:components": "npx --yes ajv-cli@5.0.0 validate --spec=draft2020 --strict=false -s spec/schemas/component-recipe.schema.json -d 'spec/components/*.recipe.json'",
    "validate:component-contracts": "node scripts/validate-component-contracts.mjs",
    "validate:themes": "npx --yes ajv-cli@5.0.0 validate --spec=draft2020 --strict=false -s spec/schemas/theme.schema.json -d 'spec/themes/*.theme.json'",
    "validate:theme-contracts": "node scripts/validate-theme-contracts.mjs",
    "validate:spec": "npm run validate:dtcg && npm run validate:manifest && npm run validate:components && npm run validate:component-contracts && npm run validate:themes && npm run validate:theme-contracts",
    "compile:spec": "node packages/compiler/src/index.mjs --output build/spec-ir.json",
    "build:web-tokens": "node packages/adapter-web/src/generate-css.mjs build/spec-ir.json build/web/tokens.css",
    "build:web-contracts": "node packages/adapter-web/src/generate-contracts.mjs build/spec-ir.json build/web/contracts.ts",
    "build:web-components": "node packages/adapter-web/src/generate-components-css.mjs build/spec-ir.json build/web/components.css",
    "build:kotlin-contracts": "node packages/adapter-compose/src/generate-contracts.mjs build/spec-ir.json build/compose/GuiContracts.kt",
    "build:kotlin-tokens": "node packages/adapter-compose/src/generate-tokens.mjs build/spec-ir.json build/compose/GuiTokens.kt",
    "build:kotlin-visuals": "node packages/adapter-compose/src/generate-visuals.mjs build/spec-ir.json build/compose/GuiVisuals.kt",
    "test:spec": "node scripts/test-spec.mjs",
    "test:theme-resolution": "node scripts/test-theme-resolution.mjs",
    "test:capability-resolution": "node scripts/test-capability-resolution.mjs",
    "test:visual-resolution": "node scripts/test-visual-resolution.mjs",
    "test:accessibility": "node scripts/test-accessibility.mjs",
    "test:web-adapter": "node scripts/test-web-adapter.mjs",
    "test:web-contracts": "node scripts/test-web-contracts.mjs",
    "test:web-button": "node scripts/test-web-button.mjs",
    "test:web-input": "node scripts/test-web-input.mjs",
    "test:web-switch": "node scripts/test-web-switch.mjs",
    "test:web-panel": "node scripts/test-web-panel.mjs",
    "test:web-dialog": "node scripts/test-web-dialog.mjs",
    "test:kotlin-contracts": "node scripts/test-compose-contracts.mjs",
    "test:kotlin-tokens": "node scripts/test-compose-tokens.mjs",
    "test:kotlin-visuals": "node scripts/test-compose-visuals.mjs",
    "test:kotlin-switch": "node scripts/test-compose-switch.mjs",
    "test:kotlin-panel": "node scripts/test-compose-panel.mjs",
    "test:kotlin-dialog": "node scripts/test-compose-dialog.mjs",
    "typecheck:web-contracts": "npx --yes --package typescript@7.0.2 tsc --noEmit --strict --target ES2022 --module ESNext build/web/contracts.ts",
    "compile:kotlin-contracts": "mvn -q -f packages/adapter-compose/pom.xml compile",
    "check": "npm run validate:spec && npm run compile:spec && npm run test:spec && npm run test:theme-resolution && npm run test:capability-resolution && npm run test:visual-resolution && npm run test:accessibility && npm run build:web-tokens && npm run test:web-adapter && npm run build:web-components && npm run test:web-button && npm run test:web-input && npm run test:web-switch && npm run test:web-panel && npm run test:web-dialog && npm run build:web-contracts && npm run test:web-contracts && npm run typecheck:web-contracts && npm run build:kotlin-contracts && npm run test:kotlin-contracts && npm run build:kotlin-tokens && npm run test:kotlin-tokens && npm run build:kotlin-visuals && npm run test:kotlin-visuals && npm run test:kotlin-switch && npm run test:kotlin-panel && npm run test:kotlin-dialog && npm run compile:kotlin-contracts && npm run typecheck"
  }
}
